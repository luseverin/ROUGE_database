         "4",
         "Cuba - Hurricane Oscar (MDRCU010)",
         "Cyclone",
         "2025-04-29T18:01:00+02:00",
         "29/04/2025",
         "https://go-api.ifrc.org/api/downloadfile/90982/MDRCU010ou1",
         "Cuba",
