         "Sudan - Floods (MDRSD034)",
         "Flood",
         "2025-03-17T12:16:00+01:00",
         "17/03/2025",
         "https://go-api.ifrc.org/api/downloadfile/90654/MDRSD034du1.",
         "Sudan",
