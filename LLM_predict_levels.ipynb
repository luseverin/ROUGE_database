   "source": [
    "#select reports for which labelling has been done\n",
    "test_reports = ifrc_reports_df.where(ifrc_reports_df.appealCode.isin(labelled_df.appealCode.unique())).dropna(how='all')\n",
    "missed_reports = ifrc_reports_df.where(ifrc_reports_df.appealCode.isin([\"MDRDZ011\", \"MDRCM039\", \"MDRBJ019\", \"MDRNG041\"])).dropna(how='all')\n",
    "labelled_appeal = ['MDRDZ011','MDRPK026','MDRCM039','MDRBJ019','MDRSD034','MDRNG041','MDRRW022','MDRZM022','MDRUG050','MDRMZ024','MDRAF014','MDRCM036','MDRDZ008','MDRSY006','MDRBR010','MDRID013','MDR55001','MDRLA009','MDRMG020']\n",
    "labelled_reports = ifrc_reports_df.where(ifrc_reports_df.appealCode.isin(labelled_appeal)).dropna(how='all')"
