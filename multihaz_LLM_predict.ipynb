      "source": [
        "# To use the model, you will need to sign up for an OpenAI Account (http://platform.openai.com/signup) and get an API key pasted below.\n",
        "# so we will use this particular model\n",
        "## this the API key given by Tais\n",
        "API_KEY = os.getenv("GROQ_API_KEY")
        "MODEL_NAME =  \"gpt-4o-mini\"#\"gpt-3.5-turbo-0125\"\n",
        "CLIENT = OpenAI(api_key=API_KEY)\n",
        "\n",
        "def get_model_response(CLIENT, MODEL, prompt):\n",
        "  completion = CLIENT.chat.completions.create(\n",
        "    model=MODEL,\n",
        "    messages=[\n",
        "      {\"role\": \"user\", \"content\": prompt}\n",
        "    ],\n",
        "    temperature=0\n",
        "  )\n",
        "\n",
        "  return completion.choices[0].message.content\n",
        "\n",
        "def extract_outer_json(text):\n",
        "    start_index = text.find('{')\n",
        "    end_index = text.rfind('}')\n",
        "\n",
        "    if start_index == -1 or end_index == -1 or start_index >= end_index:\n",
        "        return None  # Return None for empty JSON or invalid format\n",
        "\n",
        "    extracted_json = text[start_index:end_index + 1]\n",
        "    return extracted_json"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 15,
      "metadata": {},
      "outputs": [],
      "source": [
        "from tqdm import tqdm\n",
        "import time\n",
        "def make_predictions(input_text_json, result_dict):\n",
        "    for i, report in tqdm(enumerate(input_text_json), desc=\"Loop\"):\n",
        "        start_time = time.time()\n",
        "        report_id = report['appealCode']\n",
        "        input_text = report['header']\n",
        "        prompt = build_instruction_v2(hazard_patterns,input_text)\n",
        "        result = get_model_response(CLIENT, MODEL_NAME, prompt)\n",
        "        result_json = extract_outer_json(result)\n",
        "        result_dict[report_id] = {}\n",
        "        result_dict[report_id]['input_text'] = input_text\n",
        "        result_dict[report_id]['results'] = result_json\n",
        "        iteration_time = time.time() - start_time\n",
        "\n",
        "        tqdm.write(f\"Iteration {i+1} took {iteration_time - (i * 0.1):.2f} seconds\")\n",
        "\n",
        "\n",
        "    return result_dict"
      ]
    },
