      "source": [
        "import os\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import random\n",
        "\n",
        "# set seeds for reproducibility\n",
        "np.random.seed(42)\n",
        "random.seed(42)\n",
        "\n",
        "\n",
        "# lets setup some global variables\n",
        "\n",
        "# for goal prediction this will be the number of classes\n",
        "#N_PRED_CLASSES = len(goal_idx_2_goal_number)\n",
        "\n",
        "#hazard patterns to classify the hazards\n",
        "hazard_patterns = {\n",
        "'Drought': r\"drought.|dry spell.\",\n",
        "'Flood': r\"\\b(flood|floods|flooding|inundation|inundations|glacial lake outburst)\\b\",\n",
        "'Storm': r\"storm.|superstorm.|tornado.|windstorm.|snowstorm.|snowfal.|blizzard.|derecho.|winterstorm.|hail.|extra tropical storm.|thunderstorm.\",\n",
        "'Tornado': r\"tornado.*\",\n",
        "'Storm surge': r\"storm surge.*\",\n",
        "'Heatwave': r\"heat wave.|heatwave.|heat episode.|((heat|hot) spell).|heat stress.*\",\n",
        "'Coldwave': r\"cold wave.|coldwave.|severe winter conditions.|cold spell.\",\n",
        "'Mass movement': r\"land slide.|landslide.|rockfall.|mudslide.|mass movement.*\",\n",
        "'Cyclone': r\"cyclone.|tropical cyclone.|hurricane.|typhoon.\",\n",
        "'Tidal Wave': r\"tidal wav.*\",\n",
        "'Wildfire': r\"fire.|forestfire.|wildfire.|landfire.|bushfire.|forest fire.|wild fire.|land fire.|bush fire.*\" }\n",
        "\n",
        "# this will signify to the model the start of the input text\n",
        "INPUT_MARKER = 'Input Text'"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "id": "LaqbtbPrGRgb"
      },
      "outputs": [],
      "source": [
        "## results are very sensitive to details e.g. if the text is inputed in the middle or in the end, using {} or []...\n",
        "# for now, version 2 to work best\n",
        "\n",
        "def build_instruction_v2(hazard_patterns, input_text, output_fields=None):\n",
        "    ''' v2: input_text addedin the middle\n",
        "        Args:\n",
        "            hazard_patterns: a dict. of the hazards categories and regex patterns\n",
        "            input_text: input text from which hazard events must be identified\n",
        "        Returns:\n",
        "            prompt (str): the prompt that will be used to query the model\n",
        "\n",
        "    '''\n",
        "    # describe what the model's input, task and class options are.\n",
        "    prompt = f\"\"\"Based on the provided article [{input_text}], please extract information about all hazards \"Hazard\", their location, starting date and ending date and assign the details as follows:\n",
        "-\"Hazard \": \"identify the hazard categories referring to the following hazards:\n",
        "hazard_patterns={hazard_patterns}\n",
        "Only one category should be assigned.\"\n",
        "- “Country”: List all countries affected by the \"Hazard\" If no locations are mentioned, enter \"NULL\".\n",
        "-\"Location\": \"List all cities mentioned in the text as being affected by \"Hazard\". If no locations are mentioned, enter \"NULL\".\n",
        "-\"Start_Date\": \"The start date of the event. If the specific day or month is not known, include at least the year if it's available. If no time information is available, enter 'NULL'. If the exact date is not clear (e.g., \"summer of 2021\", \"June 2020\"), please retain the text as mentioned.\"\n",
        "- \"End_Date\": \"The end date of the event. If the specific day or month is not known, include at least the year if it's available. If no time information is available, enter 'NULL'. If the exact date is not clear (e.g., \"summer of 2021\", \"June 2020\"), please retain the text as mentioned.\n",
        "- \"Sentences\": \"Include text from the original text that supports your findings for each category. This should directly quote the original text.\"\n",
        "Please give the json format output of these four items above.\"\"\"\n",
        "\n",
        "    return prompt"
      ]
    },
    {
