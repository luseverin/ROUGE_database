   "source": [
    "from IPython.core.display import display, HTML\n",
    "\n",
    "def visualize(answer):\n",
    "  answer_html = f\"<p>{answer}</p>\".replace(\"\\n\", \"</p><p>\")\n",
    "  in_html = f\"\"\"\n",
    "            <h3>Output:</h3>\n",
    "            {answer_html}\n",
    "            \"\"\"\n",
    "  display(HTML(in_html))"
